# Digital Investor Onboarding System - Environment Configuration Example
# Copy this file to .env and configure your real SMTP credentials if available.

# Database Credentials
DB_HOST=localhost
DB_NAME=digital_investor
DB_USER=root
DB_PASS=

# Backend Email / SMTP Provider Configuration
# Set real credentials below to enable live email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=noreply@digitalinvestor.com
SMTP_FROM_NAME="Digital Investor System"

# Demo Mode Toggle:
# Set DEMO_MODE=true to force Demo Mode (displays link on UI without sending real email)
# Set DEMO_MODE=false to use configured SMTP credentials
DEMO_MODE=true
